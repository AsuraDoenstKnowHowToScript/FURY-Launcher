<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uic="using:FluentAvalonia.UI.Controls"
        xmlns:uip="using:FluentAvalonia.UI.Controls.Primitives">

    <!-- Global text defaults.

         Deliberately no Foreground. A style setter beats inheritance, so setting it here made
         every TextBlock ignore the colour of whatever contained it — which is fine until a
         container is a pale button, and then its dark label is overruled by this and you get
         light text on a light fill. The window sets Foreground once, so the default is the same
         as it was; the difference is that a control can now actually colour its own content.

         SemiBold: Inter is drawn for interfaces and stays crisp at the 11-13px this window is
         full of, but anything lighter loses its stems on a dark background. -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ============================ SIDEBAR ============================ -->
    <!-- Items read as a list inside the pane rather than a column of buttons: transparent
         at rest, inset from both edges so the rounded selection has somewhere to sit, and
         only the current one carries a fill. The colours for every state come from
         Tokens.axaml; what is set here is shape and rhythm. -->
    <Style Selector="uic|NavigationViewItem">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Margin" Value="10,3"/>
    </Style>
    <!-- The presenter is the part that actually paints an item, so the corner and the
         outline belong to it, not to the item. -->
    <Style Selector="uic|NavigationViewItem /template/ uip|NavigationViewItemPresenter#NVIPresenter">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                <!-- Fill, rim and text all move on hover, and all three hold for as long as the
                     pointer is on the item. -->
                <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <!-- Groups are separated by a rule in the pane rather than by a caption. The labels were
         two more lines of small text in a place that has room for five items, and the split
         between playing and managing is obvious enough without being narrated. -->
    <Style Selector="uic|NavigationViewItemSeparator">
        <Setter Property="Margin" Value="18,10"/>
    </Style>

    <!-- ============================ BUTTONS ============================ -->
    <!-- Variants are opt-in via Classes; plain buttons keep the Fluent look.
         Subtle 120ms colour transitions, no glow/scale. Inline paddings in
         views still win over these defaults.

         Every state restates Background, BorderBrush and Foreground even where the
         value is unchanged. The Fluent theme sets the same three properties on the
         same content presenter for :pointerover and :pressed, so leaving one out
         hands that property to the theme for the duration of the state, and the
         colour transition animates through whatever it hands back. Tokens.axaml
         already points the theme's own keys at our palette; these setters are the
         second half of that, and together they are why hover no longer flashes. -->

    <!-- primary -->
    <Style Selector="Button.primary">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8"/>
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="Background" Duration="0:0:0.12"/></Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressed}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    </Style>

    <!-- secondary -->
    <Style Selector="Button.secondary">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Padding" Value="14,8"/>
    </Style>
    <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GlassElevated}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverTint}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TitaniumEdge}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PressTint}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TitaniumEdgeSoft}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <!-- danger (destructive only: delete instance, remove mod) -->
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Padding" Value="14,8"/>
    </Style>
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Danger}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
        <Setter Property="Transitions">
            <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12"/></Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Danger}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Opacity" Value="0.85"/>
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Danger}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <!-- ghost -->
    <Style Selector="Button.ghost">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Padding" Value="12,7"/>
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <!-- The border is always there, just invisible at rest. Growing one on hover would
             move everything inside by a pixel, which is its own kind of flicker. -->
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <!-- Hover paints nothing. The text and icon coming up to full is the entire cue. -->
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverTint}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TitaniumEdgeSoft}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PressTint}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <!-- ============================ INPUTS ============================ -->

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource GlassInput}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.12"/></Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource TitaniumEdgeSoft}"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- Bare TextBox: no chrome of its own, for use inside a styled wrapper (search field).
         The wrapper carries the border and lights up when anything inside has focus. -->
    <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.searchwrap">
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.12"/></Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.searchwrap:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- The dropdown is styled in one place, further down under DROPDOWN. There used to be a
         second, earlier set of rules for it here; the later ones silently won, so fixing this
         copy fixed nothing. Do not restore it. -->

    <!-- ============================ LISTS ============================ -->

    <Style Selector="ListBox">
        <Setter Property="Background" Value="{DynamicResource GlassInput}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
    </Style>
    <!-- No outline on the row itself. Most rows in this app wrap a Border.card, which lights
         its own outline on hover; giving the row one too would draw two rings inside each
         other. Rows without a card lift their text instead. -->
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <!-- Selected: subtle accent tint, not the full purple -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
    </Style>

    <!-- ============================ MISC ============================ -->

    <!-- Scroll bars sat flush against the cards they scroll, which reads as the track being part
         of the card rather than chrome beside it. A gutter on the inner edge separates them, and
         the bar is slimmer so the gutter costs almost nothing. -->
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Background" Value="{DynamicResource GlassElevated}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}"/>
    </Style>

    <!-- Custom sliding toggle (ToggleButton.switch): a track + a knob that slides with a
         TransformOperationsTransition, so the on/off flip is always smooth. Only the track
         colour and the knob position change by state; nothing that changes is set inline
         (inline template values would override the :checked style setters). -->
    <Style Selector="ToggleButton.switch">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Track" CornerRadius="12" BorderThickness="1">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.18"/>
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
                        </Transitions>
                    </Border.Transitions>
                    <Border Name="Knob" Width="18" Height="18" CornerRadius="9"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.switch /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource GlassElevated}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <!-- Hover lives on the track outline only, and is declared after the resting and
         checked rules so it wins for the one property it touches. The knob never changes
         colour: a switch that lights up under the pointer is what the stock control does,
         and it is the thing that read as a flash. -->
    <Style Selector="ToggleButton.switch:pointerover /template/ Border#Track">
        <Setter Property="BorderBrush" Value="{DynamicResource TitaniumEdge}"/>
    </Style>
    <Style Selector="ToggleButton.switch:checked:pointerover /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
    </Style>
    <!-- The knob has to contrast with its own track, and the track changes colour with state,
         so the knob changes with it. A fixed pale knob disappeared into the pale "on" track. -->
    <Style Selector="ToggleButton.switch /template/ Border#Knob">
        <Setter Property="RenderTransform" Value="translateX(0px)"/>
        <Setter Property="Background" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform"
                                               Duration="0:0:0.18" Easing="CubicEaseOut"/>
                <BrushTransition Property="Background" Duration="0:0:0.18"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Border#Knob">
        <Setter Property="RenderTransform" Value="translateX(20px)"/>
        <Setter Property="Background" Value="{DynamicResource OnAccent}"/>
    </Style>

    <!-- Segmented control: RadioButtons re-templated as pills inside a rounded track.
         The checked pill fills with the accent; nothing state-driven is set inline. -->
    <Style Selector="RadioButton.segment">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Pill" CornerRadius="10" Padding="16,7" Background="Transparent"
                        BorderThickness="1">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.14"/>
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.14"/>
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.segment /template/ Border#Pill">
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="RadioButton.segment:pointerover /template/ Border#Pill">
        <Setter Property="Background" Value="{DynamicResource HoverTint}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TitaniumEdgeSoft}"/>
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#Pill">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="RadioButton.segment:checked">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    </Style>

    <!-- Card container: depth from a soft, wide shadow and layer contrast; the border is
         barely-there. Background and shadow both ease on hover (inside hoverable lists). -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource GlassSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BoxShadow" Value="0 6 24 0 #38000000"/>
        <Setter Property="RenderTransform" Value="translateY(0px)"/>
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.14"/>
                <BrushTransition Property="Background" Duration="0:0:0.14"/>
                <TransformOperationsTransition Property="RenderTransform"
                                               Duration="0:0:0.14" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <!-- Physically lift + brighten a card when the pointer is over it (inside a hoverable list). -->
    <Style Selector="ListBoxItem:pointerover Border.card">
        <Setter Property="BoxShadow" Value="0 10 26 0 #60000000"/>
        <Setter Property="Background" Value="{DynamicResource HoverTint}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TitaniumEdge}"/>
        <Setter Property="RenderTransform" Value="translateY(-2px)"/>
    </Style>

    <!-- Flat card: for cards inside scrolling lists. Blur shadows are the most expensive
         thing to repaint, and a non-virtualized list repaints every card on every scrolled
         pixel — so list cards trade the blur for layer contrast plus an animated accent
         outline on hover, and scrolling stays at full frame rate. -->
    <Style Selector="Border.card.flat">
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.14"/>
                <TransformOperationsTransition Property="RenderTransform"
                                               Duration="0:0:0.14" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <!-- Direct :pointerover so it also works inside plain ItemsControls (installed list). -->
    <Style Selector="Border.card.flat:pointerover">
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
        <Setter Property="Background" Value="{DynamicResource HoverTint}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TitaniumEdge}"/>
        <Setter Property="RenderTransform" Value="translateY(-2px)"/>
    </Style>

    <!-- ============================ DROPDOWN ============================
         Our own dropdown, built by restyling the theme's template parts rather than replacing
         the template: the box, the chevron and the popup all follow the launcher's tokens, the
         chevron turns as it opens, and the popup surface matches an elevated card. Restyling
         instead of retemplating keeps every ComboBox behaviour (keyboard, virtualisation,
         selection) exactly as the framework wrote it. -->
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
        <!-- Without these the selected text sits against the top of the box: the box grew to
             MinHeight but its content kept the theme's default alignment. -->
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style Selector="ComboBox /template/ ContentControl#ContentPresenter">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBox /template/ TextBlock#PlaceholderTextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource GlassInput}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.14"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource GlassInput}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TitaniumEdge}"/>
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentOutline}"/>
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource GlassInput}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- Chevron: muted at rest, accented and flipped while the list is open. -->
    <Style Selector="ComboBox /template/ Path#DropDownGlyph">
        <Setter Property="Fill" Value="{DynamicResource TextMuted}"/>
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Setter Property="RenderTransform" Value="rotate(0deg)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform"
                                               Duration="0:0:0.18" Easing="CubicEaseOut"/>
                <BrushTransition Property="Fill" Duration="0:0:0.14"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Path#DropDownGlyph">
        <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ Path#DropDownGlyph">
        <Setter Property="Fill" Value="{DynamicResource Accent}"/>
        <Setter Property="RenderTransform" Value="rotate(180deg)"/>
    </Style>

    <!-- The list surface reads as an elevated card, not a system menu. -->
    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource BgElevated}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
        <Setter Property="BoxShadow" Value="0 16 40 0 #7A000000"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverTint}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TitaniumEdgeSoft}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentOutline}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentOutline}"/>
    </Style>

    <!-- Read-only variant: same card, no hover response. A lift and an accent outline promise
         that clicking does something, so rows that are purely informational (a playtime
         ranking, a release note) opt out instead of lying about being interactive.
         Declared after the hover rule so it wins for the properties it resets. -->
    <Style Selector="Border.card.flat.static:pointerover">
        <Setter Property="Background" Value="{DynamicResource GlassSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}"/>
        <Setter Property="RenderTransform" Value="translateY(0px)"/>
    </Style>

</Styles>
