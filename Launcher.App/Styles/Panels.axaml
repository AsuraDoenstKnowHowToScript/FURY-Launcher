<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Launcher.App.Controls">

    <!-- A ControlTheme is a resource, not a style: it belongs in Styles.Resources, keyed by the
         control type, so Avalonia picks it up automatically for every PanelCard.

         Three tiers, so the treatment stays a signal instead of wallpaper:
           .feature  headline panels — dot grid + glow + the big watermark
           (default) ordinary sections — dot grid + a softer glow, no watermark
           .subtle   supporting surfaces — a faint dot grid and nothing else
         The watermark is opt-in on purpose: if every panel shouted, none would. -->
    <Styles.Resources>

        <!-- The dot grid. A VisualBrush tiled every 22px: one faint dot drawn once and repeated by
             the compositor, so the texture costs nothing to scroll. The dot is already low-alpha;
             the layer opacity in the template dials it the rest of the way. -->
        <VisualBrush x:Key="DotGrid" TileMode="Tile" Stretch="None"
                     SourceRect="0,0,22,22" DestinationRect="0,0,22,22">
            <VisualBrush.Visual>
                <Panel Width="22" Height="22" Background="Transparent">
                    <Ellipse Width="2" Height="2" Fill="#FFFFFF"
                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,1,0,0"/>
                </Panel>
            </VisualBrush.Visual>
        </VisualBrush>

        <!-- Depth: a violet bloom in the top-right corner, deliberately restrained — it should
             give the surface weight, not read as a coloured panel. -->
        <RadialGradientBrush x:Key="PanelGlow" Center="88%,0%" GradientOrigin="88%,0%"
                             RadiusX="70%" RadiusY="70%">
            <GradientStop Offset="0" Color="#382A63"/>
            <GradientStop Offset="0.5" Color="#1B1630"/>
            <GradientStop Offset="1" Color="#00181422"/>
        </RadialGradientBrush>

        <ControlTheme x:Key="{x:Type ctl:PanelCard}" TargetType="ctl:PanelCard">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background" Value="{DynamicResource GlassSurface}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <!-- Ordinary sections keep the glow at half strength. -->
            <Setter Property="TextureOpacity" Value="0.5"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border CornerRadius="{DynamicResource RadiusXl}" BorderThickness="1"
                            BorderBrush="{DynamicResource GlassBorder}"
                            Background="{TemplateBinding Background}"
                            BoxShadow="0 8 32 0 #40000000"
                            ClipToBounds="True">
                        <Panel>
                            <!-- Texture stack, bottom to top: glow, dots, edge light, watermark,
                                 content. Nothing below the content is opaque, so the backdrop
                                 shows through the whole stack and the panel reads as a film. -->
                            <Border Name="PART_Glow" Background="{StaticResource PanelGlow}"
                                    Opacity="{TemplateBinding TextureOpacity}"/>
                            <Border Name="PART_Dots" Background="{StaticResource DotGrid}" Opacity="0.035"/>
                            <!-- The bright line along the top edge. One detail, and the surface
                                 stops being a rectangle and starts being a material. -->
                            <Border Name="PART_Sheen" Background="{StaticResource GlassHighlight}"
                                    Height="90" VerticalAlignment="Top" IsHitTestVisible="False"/>

                            <!-- Anchored inside the corner rather than bleeding off it, so it reads
                                 as a deliberate mark instead of a cropped accident. -->
                            <Image Name="PART_Watermark" Source="{TemplateBinding Icon}"
                                   Width="{TemplateBinding WatermarkSize}"
                                   Height="{TemplateBinding WatermarkSize}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Margin="0,10,14,0" Opacity="0.13"
                                   IsVisible="False" IsHitTestVisible="False"/>

                            <DockPanel Margin="{TemplateBinding Padding}">
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,11,*" Margin="0,0,0,16"
                                      IsVisible="{TemplateBinding ShowHeader}">
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentSubtle}"
                                            BorderBrush="{DynamicResource AccentOutline}" BorderThickness="1">
                                        <Image Source="{TemplateBinding Icon}" Width="17" Height="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Classes="Subtitle" VerticalAlignment="Center"
                                               Text="{TemplateBinding Header}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </DockPanel>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>

            <!-- Headline: the watermark appears and the glow goes to full. -->
            <Style Selector="^.feature">
                <Setter Property="TextureOpacity" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource GlassElevated}"/>
            </Style>
            <Style Selector="^.feature /template/ Image#PART_Watermark">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
            <Style Selector="^.feature /template/ Border#PART_Dots">
                <Setter Property="Opacity" Value="0.05"/>
            </Style>

            <!-- Supporting: keep the texture, drop the drama. -->
            <Style Selector="^.subtle">
                <Setter Property="TextureOpacity" Value="0"/>
            </Style>
            <Style Selector="^.subtle /template/ Border#PART_Dots">
                <Setter Property="Opacity" Value="0.02"/>
            </Style>
            <!-- Supporting surfaces get no edge light: the sheen is what marks a panel as a
                 headline, and every panel having one is the same as none of them having one. -->
            <Style Selector="^.subtle /template/ Border#PART_Sheen">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
        </ControlTheme>

    </Styles.Resources>
</Styles>
