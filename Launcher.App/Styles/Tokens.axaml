<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

    <!-- ============================================================
         DESIGN TOKENS: the single source of truth for colour, radius,
         spacing and type. Views must reference these via {DynamicResource};
         no hard-coded colours anywhere. Aesthetic: iron and titanium on black.
         No colour anywhere except the three status hues; everything else is
         metal, and depth comes from layer contrast and lit edges.
         ============================================================ -->

    <!-- Fonts (embedded; no system install needed) -->
    <!-- Inter: a face drawn for interfaces, so it holds its shape at 11px where a display face
         like Outfit goes spindly. Four weights ship, which is the whole hierarchy; the rest of
         the family would be megabytes nothing references. SIL Open Font License. -->
    <FontFamily x:Key="FontUi">avares://Bonfire Launcher/Assets/Fonts/Inter-Regular.ttf#Inter</FontFamily>
    <FontFamily x:Key="FontMono">avares://Bonfire Launcher/Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
    <!-- Monocraft: a pixel face in the shape of the one the game uses, under the SIL Open Font
         License so it can ship here. The game's own font is Mojang's and is not redistributable.
         Used only where the content belongs to Minecraft rather than to the launcher, which today
         means a server's MOTD and the numbers next to it. -->
    <FontFamily x:Key="FontMinecraft">avares://Bonfire Launcher/Assets/Fonts/Monocraft.ttf#Monocraft</FontFamily>

    <!-- Colours (raw). Neutral iron greys, no hue at all. Colour in this window is reserved
         for the three states that mean something — success, warning, danger — so anything
         coloured is information rather than decoration.

         Surfaces above the base are translucent rather than solid: a light film over whatever is
         behind, which is what makes a panel read as glass instead of as a lighter grey rectangle.
         The base is the only opaque layer, and it carries a gradient for the films to pick up. -->
    <Color x:Key="BgBaseColor">#08090A</Color>
    <Color x:Key="BgSurfaceColor">#131416</Color>
    <Color x:Key="BgElevatedColor">#1B1C1F</Color>
    <Color x:Key="BgHoverColor">#232427</Color>
    <Color x:Key="BgInputColor">#0D0E0F</Color>
    <Color x:Key="BorderSubtleColor">#232427</Color>
    <Color x:Key="BorderStrongColor">#34363A</Color>

    <!-- Titanium, not violet. The accent is a cool metal light enough to sit on black and be
         read as a highlight rather than a colour, which is what keeps the window monochrome
         while still having something that leads. Text on it is near-black, because a pale
         accent carries dark type the way a dark accent carries pale type. -->
    <Color x:Key="AccentColor">#C4C9D2</Color>
    <Color x:Key="AccentHoverColor">#DDE1E8</Color>
    <Color x:Key="AccentPressedColor">#9DA3AE</Color>
    <Color x:Key="OnAccentColor">#0B0C0D</Color>

    <Color x:Key="TextPrimaryColor">#F4F5F7</Color>
    <Color x:Key="TextSecondaryColor">#B9BCC2</Color>
    <Color x:Key="TextMutedColor">#7E828A</Color>
    <Color x:Key="SuccessColor">#4ADE80</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="DangerColor">#F87171</Color>

    <!-- Brushes (what Views actually reference) -->
    <SolidColorBrush x:Key="BgBase" Color="{StaticResource BgBaseColor}"/>
    <SolidColorBrush x:Key="BgSurface" Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="BgElevated" Color="{StaticResource BgElevatedColor}"/>
    <SolidColorBrush x:Key="BgHover" Color="{StaticResource BgHoverColor}"/>
    <SolidColorBrush x:Key="BgInput" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}"/>
    <!-- A pale accent needs far less alpha than a dark one to register as a selected row. -->
    <SolidColorBrush x:Key="AccentSubtle" Color="{StaticResource AccentColor}" Opacity="0.10"/>
    <SolidColorBrush x:Key="AccentOutline" Color="{StaticResource AccentColor}" Opacity="0.40"/>
    <!-- The tonal step a control takes under the pointer. White at four percent: enough to
         register as "this one", not enough to read as a block appearing. -->
    <SolidColorBrush x:Key="HoverTint" Color="#FFFFFF" Opacity="0.04"/>
    <SolidColorBrush x:Key="PressTint" Color="#000000" Opacity="0.18"/>
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>

    <!-- ============================ GLASS ============================
         Films, not fills. Each is white at a low alpha, so a panel takes its colour from the
         backdrop behind it and layers read as depth rather than as a palette of greys. The
         highlight is the thin bright line along a panel's top edge that sells the material:
         glass catches light on the edge facing it. -->
    <SolidColorBrush x:Key="GlassSurface" Color="#FFFFFF" Opacity="0.038"/>
    <SolidColorBrush x:Key="GlassElevated" Color="#FFFFFF" Opacity="0.062"/>
    <SolidColorBrush x:Key="GlassInput" Color="#000000" Opacity="0.22"/>
    <SolidColorBrush x:Key="GlassBorder" Color="#FFFFFF" Opacity="0.075"/>
    <SolidColorBrush x:Key="GlassBorderStrong" Color="#FFFFFF" Opacity="0.13"/>
    <LinearGradientBrush x:Key="GlassHighlight" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#20FFFFFF"/>
        <GradientStop Offset="0.45" Color="#06FFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </LinearGradientBrush>

    <!-- The window backdrop. Translucent panels need something with variation behind them or
         they have nothing to catch; a flat black would make every film the same flat grey. One
         cool bloom off the top-left, well below the level you would consciously notice. -->
    <RadialGradientBrush x:Key="AppBackdrop" Center="18%,0%" GradientOrigin="18%,0%"
                         RadiusX="95%" RadiusY="85%">
        <GradientStop Offset="0" Color="#1A1C20"/>
        <GradientStop Offset="0.55" Color="#0D0E10"/>
        <GradientStop Offset="1" Color="#08090A"/>
    </RadialGradientBrush>

    <!-- The Bonfire wordmark, in brushed metal: bright where light would catch, dark where it
         would fall away. Same sweep as the outline, so the mark and the edges are one material. -->
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#EDF0F4"/>
        <GradientStop Offset="0.5" Color="#A8AEB9"/>
        <GradientStop Offset="1" Color="#6E747E"/>
    </LinearGradientBrush>

    <!-- The outline that marks something as live: a titanium sweep rather than a flat line, so
         an edge reads as a lit rim on metal instead of a coloured border drawn around a box. -->
    <LinearGradientBrush x:Key="TitaniumEdge" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#D6DAE1"/>
        <GradientStop Offset="0.45" Color="#8B919B"/>
        <GradientStop Offset="1" Color="#585D66"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitaniumEdgeSoft" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#7FD6DAE1"/>
        <GradientStop Offset="0.45" Color="#5A8B919B"/>
        <GradientStop Offset="1" Color="#42585D66"/>
    </LinearGradientBrush>

    <!-- Radii: roomier corners, closer to a modern web card than a desktop widget. -->
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">12</CornerRadius>
    <CornerRadius x:Key="RadiusLg">18</CornerRadius>
    <CornerRadius x:Key="RadiusXl">24</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- Spacing scale (base 4) -->
    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space6">24</sys:Double>
    <sys:Double x:Key="Space8">32</sys:Double>

    <!-- Theme overrides: give the nav pane its own (slightly deeper) layer so the
         sidebar reads as chrome and the content as the page. Unknown keys are ignored
         by the theme, so these are safe no-ops on other platforms/themes.

         The pane falls off vertically instead of sitting flat. It is the tallest surface
         in the window, and a single flat tone over that height reads as a slab; the
         gradient is small enough that you would not name it, which is the point. -->
    <LinearGradientBrush x:Key="NavigationViewDefaultPaneBackground" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#14FFFFFF"/>
        <GradientStop Offset="1" Color="#06FFFFFF"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavigationViewExpandedPaneBackground" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#14FFFFFF"/>
        <GradientStop Offset="1" Color="#06FFFFFF"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
    <sys:Double x:Key="ScrollBarSize">10</sys:Double>

    <!-- Sidebar items. Same rule as every other control here: a state left unnamed is
         painted from the stock palette, and the sidebar was still on it.
         Resting is transparent so the pane itself shows through and the items read as a
         list, not a stack of buttons. Selected is the accent at low alpha with a matching
         outline, which is enough to find at a glance without competing with the page. -->
    <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#FFFFFF" Opacity="0.04"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="{StaticResource AccentColor}" Opacity="0.16"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{StaticResource AccentColor}" Opacity="0.16"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{StaticResource AccentColor}" Opacity="0.22"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{StaticResource AccentColor}" Opacity="0.26"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundChecked" Color="{StaticResource AccentColor}" Opacity="0.16"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundCheckedPointerOver" Color="{StaticResource AccentColor}" Opacity="0.22"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundCheckedPressed" Color="{StaticResource AccentColor}" Opacity="0.26"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundCheckedDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="NavigationViewItemBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="NavigationViewItemBorderBrushDisabled" Color="Transparent"/>
    <LinearGradientBrush x:Key="NavigationViewItemBorderBrushPointerOver" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#7FD6DAE1"/>
        <GradientStop Offset="0.45" Color="#5A8B919B"/>
        <GradientStop Offset="1" Color="#42585D66"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavigationViewItemBorderBrushPressed" Color="{StaticResource AccentColor}"/>
    <LinearGradientBrush x:Key="NavigationViewItemBorderBrushSelected" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#D6DAE1"/>
        <GradientStop Offset="0.45" Color="#8B919B"/>
        <GradientStop Offset="1" Color="#585D66"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavigationViewItemBorderBrushSelectedPointerOver" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#D6DAE1"/>
        <GradientStop Offset="0.45" Color="#8B919B"/>
        <GradientStop Offset="1" Color="#585D66"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavigationViewItemBorderBrushSelectedPressed" Color="{StaticResource AccentColor}" Opacity="0.55"/>
    <SolidColorBrush x:Key="NavigationViewItemBorderBrushSelectedDisabled" Color="Transparent"/>
    <LinearGradientBrush x:Key="NavigationViewItemBorderBrushChecked" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#D6DAE1"/>
        <GradientStop Offset="0.45" Color="#8B919B"/>
        <GradientStop Offset="1" Color="#585D66"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavigationViewItemBorderBrushCheckedPointerOver" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#D6DAE1"/>
        <GradientStop Offset="0.45" Color="#8B919B"/>
        <GradientStop Offset="1" Color="#585D66"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavigationViewItemBorderBrushCheckedPressed" Color="{StaticResource AccentColor}" Opacity="0.55"/>
    <SolidColorBrush x:Key="NavigationViewItemBorderBrushCheckedDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedDisabled" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundChecked" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundCheckedPointerOver" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundCheckedPressed" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundCheckedDisabled" Color="{StaticResource TextMutedColor}"/>
    <!-- Group labels above each run of items, and the bar that marks the current section. -->
    <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource AccentColor}"/>

    <!-- Button state brushes, restated in our palette.
         The Fluent theme sets these on the button's content presenter for :pointerover
         and :pressed, and Controls.axaml sets the same properties from a Style. Both
         values reach the property, ours wins the final result, but the theme's value
         still lands on the way there and the colour transition animates towards it for
         a moment before it is corrected. That detour is the pale flash on the way in and
         on the way out. Pointing the theme's own keys at our colours means the detour
         goes nowhere visible, whichever value gets there first.
         Pressed sits below the resting layer: buttons look pushed in, not lit up. -->
    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource BgElevatedColor}"/>
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource BgElevatedColor}"/>
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource BorderSubtleColor}"/>
    <!-- Text keeps its resting colour through hover. The theme's version jumps to pure
         white, which is the other half of the flash on anything with grey text. -->
    <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource TextMutedColor}"/>

    <!-- ============================================================
         The rest of the interactive palette, restated the same way.
         Controls.axaml styles the resting look of these controls, but a control has a
         state for every combination of pointer, press, focus and selection, and any state
         a style does not name is still painted from the theme's stock palette. Those stock
         colours are built for a light-grey Fluent surface, so on this one they arrive as a
         pale wash — which is the flash. Restating the keys here means there is no stock
         colour left to arrive: whichever value wins a given state, it is one of ours.
         Keys the theme does not know are ignored, so nothing here can break a control.
         ============================================================ -->

    <!-- Dropdowns. The closed box never changes fill; only the outline answers the pointer. -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundPointerOver" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundPressed" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocused" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="ComboBoxEditableDropDownGlyphForeground" Color="{StaticResource TextSecondaryColor}"/>

    <!-- The open list. -->
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPressed" Color="{StaticResource AccentColor}" Opacity="0.16"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerPressed" Color="{StaticResource AccentColor}" Opacity="0.16"/>
    <SolidColorBrush x:Key="ComboBoxFocusedDropDownBackgroundPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBoxFocusedDropDownBackgroundPointerPressed" Color="{StaticResource AccentColor}" Opacity="0.16"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="{StaticResource TextPrimaryColor}"/>

    <!-- Rows in the open list. Selected is an accent tint, never the full purple. -->
    <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="{StaticResource AccentColor}" Opacity="0.16"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource AccentColor}" Opacity="0.15"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="{StaticResource AccentColor}" Opacity="0.15"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource AccentColor}" Opacity="0.22"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{StaticResource AccentColor}" Opacity="0.28"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedUnfocused" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedDisabled" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushPointerOver" Color="{StaticResource AccentColor}" Opacity="0.55"/>
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushPressed" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelected" Color="{StaticResource AccentColor}" Opacity="0.55"/>
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedUnfocused" Color="{StaticResource AccentColor}" Opacity="0.55"/>
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPointerOver" Color="{StaticResource AccentColor}" Opacity="0.55"/>
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPressed" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedDisabled" Color="Transparent"/>

    <!-- Text fields, including the read-only log box. Same rule: the fill never moves. -->
    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="{StaticResource TextMutedColor}"/>
    <!-- The inline clear button inside a text field. -->
    <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="{StaticResource AccentColor}" Opacity="0.16"/>
    <SolidColorBrush x:Key="TextControlButtonBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlButtonBorderBrushPointerOver" Color="{StaticResource AccentColor}" Opacity="0.55"/>
    <SolidColorBrush x:Key="TextControlButtonBorderBrushPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlButtonForeground" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="{StaticResource TextSecondaryColor}"/>

    <!-- Checkboxes: the box is an input surface off, accent on, and the tick is never grey. -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled" Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" Color="{StaticResource BgElevatedColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPressed" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="CheckBoxForegroundUncheckedDisabled" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="{StaticResource TextPrimaryColor}"/>
