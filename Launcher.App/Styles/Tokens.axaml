    <SolidColorBrush x:Key="CheckBoxForegroundCheckedPressed" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="CheckBoxForegroundCheckedDisabled" Color="{StaticResource TextMutedColor}"/>

</ResourceDictionary>
