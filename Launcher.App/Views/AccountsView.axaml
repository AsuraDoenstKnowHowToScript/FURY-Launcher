<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icon="using:IconPacks.Avalonia.Lucide"
             xmlns:vm="using:Launcher.App.ViewModels"
             xmlns:behaviors="using:Launcher.App.Behaviors"
             xmlns:ctl="using:Launcher.App.Controls"
             x:Class="Launcher.App.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">

    <!-- One account = one playable identity. The card list on the left is the selector
         (offline + Microsoft together); the editor on the right adapts per account
         (offline = editable skin/nick; Microsoft = read-only Mojang skin). -->
    <ScrollViewer behaviors:SmoothScroll.Enabled="True">
        <StackPanel Margin="24" Spacing="16" MaxWidth="1180"
                    HorizontalAlignment="Stretch">

            <!-- Add-account bar -->
            <Border Classes="card" Padding="18">
                <Grid ColumnDefinitions="Auto,16,*,Auto" VerticalAlignment="Center">
                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12"
                            Background="{DynamicResource AccentSubtle}"
                            BorderBrush="{DynamicResource AccentOutline}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <Image Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="{icon:LucideImage Kind=User, Brush={StaticResource TextSecondary}}"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="Subtitle" Text="{Binding HeaderText}"/>
                        <TextBlock Text="{Binding AccountStatusText}"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <Button Classes="secondary" Content="{Binding AddOfflineText}"
                                Command="{Binding AddOfflineCommand}"/>
                        <Button Classes="primary" Command="{Binding AddMicrosoftCommand}"
                                IsEnabled="{Binding !IsAddingMicrosoft}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Grid Width="15" Height="15" ColumnDefinitions="7,1,7" RowDefinitions="7,1,7">
                                    <Border Grid.Row="0" Grid.Column="0" Background="#F25022"/>
                                    <Border Grid.Row="0" Grid.Column="2" Background="#7FBA00"/>
                                    <Border Grid.Row="2" Grid.Column="0" Background="#00A4EF"/>
                                    <Border Grid.Row="2" Grid.Column="2" Background="#FFB900"/>
                                </Grid>
                                <TextBlock Text="{Binding AddMicrosoftText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Two columns: card selector | editor for the selected account -->
            <Grid ColumnDefinitions="360,20,*">

                <!-- Left: the account cards (the selector) -->
                <ctl:PanelCard Grid.Column="0" ShowHeader="False" Padding="18" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="Subtitle" Text="{Binding ListHeaderText}"/>
                        <ListBox ItemsSource="{Binding Cards}"
                                 SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                                 Background="Transparent" Padding="2"
                                 behaviors:SmoothScroll.Enabled="True" MaxHeight="480"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected Border.card">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccountCardVm">
                                    <Border Classes="card flat" Padding="12" MinHeight="66">
                                        <Grid ColumnDefinitions="Auto,12,*,Auto">
                                            <!-- Composited head avatar: base face + hat overlay -->
                                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                                                    ClipToBounds="True" VerticalAlignment="Center"
                                                    Background="{DynamicResource BgElevated}">
                                                <Panel>
                                                    <Image Width="20" Height="20" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasFace}"
                                                           Source="{icon:LucideImage Kind=User, Brush={StaticResource TextMuted}}"/>
                                                    <Image Source="{Binding Face}" Stretch="Uniform"
                                                           RenderOptions.BitmapInterpolationMode="None"/>
                                                    <Image Source="{Binding Hat}" Stretch="Uniform"
                                                           RenderOptions.BitmapInterpolationMode="None"/>
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Username}" Classes="Body"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Badge}" Classes="Caption"
                                                           Foreground="{DynamicResource TextMuted}"/>
                                            </StackPanel>
                                            <Border Grid.Column="3" Width="9" Height="9" CornerRadius="999"
                                                    VerticalAlignment="Center" Margin="6,0,2,0"
                                                    Background="{DynamicResource Accent}"
                                                    IsVisible="{Binding IsActive}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                                   HorizontalAlignment="Center" Margin="0,8"
                                   Foreground="{DynamicResource TextMuted}"/>
                        <Button Classes="secondary" Content="{Binding DeleteText}"
                                Command="{Binding DeleteCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ctl:PanelCard>

                <!-- Right: editor for the selected account -->
                <ctl:PanelCard Grid.Column="2" ShowHeader="False" Padding="20">
                    <Panel>
                        <TextBlock Text="{Binding SelectHintText}" IsVisible="{Binding HintVisible}"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <StackPanel IsVisible="{Binding EditorVisible}">
                            <Grid ColumnDefinitions="*,24,Auto">
                                <StackPanel Grid.Column="0" Spacing="18">

                                    <!-- Identity -->
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding NickLabel}" VerticalAlignment="Center"/>
                                            <TextBox Width="220" Text="{Binding Nick, Mode=TwoWay}"
                                                     IsEnabled="{Binding CanEdit}"/>
                                        </StackPanel>
                                        <CheckBox Content="{Binding SlimText}"
                                                  IsChecked="{Binding IsSlim, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanEdit}"/>
                                        <TextBlock Classes="Caption" Text="{Binding NickHintText}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                        <Button Classes="primary" Content="{Binding SaveText}"
                                                Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource BorderSubtle}"/>

                                    <!-- Appearance -->
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Width="17" Height="17" VerticalAlignment="Center"
                                                   Source="{icon:LucideImage Kind=Palette, Brush={StaticResource TextSecondary}}"/>
                                            <TextBlock Classes="Subtitle" Text="{Binding AppearanceHeaderText}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{Binding ChooseSkinText}" Command="{Binding ChooseSkinCommand}"
                                                    IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Binding SkinTooltip}"/>
                                            <Button Classes="secondary" Content="{Binding ChooseCapeText}"
                                                    Command="{Binding ChooseCapeCommand}"
                                                    IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Binding SkinTooltip}"/>
                                        </StackPanel>
                                        <TextBlock IsVisible="{Binding MsNoteVisible}" TextWrapping="Wrap"
                                                   Classes="Caption" Foreground="{DynamicResource TextMuted}"
                                                   Text="{Binding MsManagedText}"/>
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource BorderSubtle}"/>

                                    <!-- Apply in-game -->
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Image Width="17" Height="17" VerticalAlignment="Center"
                                                   Source="{icon:LucideImage Kind=Play, Brush={StaticResource TextSecondary}}"/>
                                            <TextBlock Text="{Binding ApplyInstanceLabel}"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource BgElevated}" CornerRadius="999"
                                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                    Padding="12,6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding InstanceName}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </Border>
                                            <Button Classes="primary" Content="{Binding ApplyText}"
                                                    Command="{Binding ApplySkinCommand}"
                                                    IsEnabled="{Binding !IsApplyingSkin}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Live previews -->
                                <Border Grid.Column="2" Background="{DynamicResource BgElevated}" CornerRadius="14"
                                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                        Padding="18" VerticalAlignment="Top">
                                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding FacePreviewLabel}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                            <Border CornerRadius="10" ClipToBounds="True" Padding="6"
                                                    Background="{DynamicResource BgSurface}"
                                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                                <Image Width="120" Height="120" Source="{Binding FacePreview}"
                                                       Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding CapePreviewLabel}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                            <Border CornerRadius="10" ClipToBounds="True" Padding="6"
                                                    Background="{DynamicResource BgSurface}"
                                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                                <Image Width="140" Height="72" Source="{Binding CapePreview}"
                                                       Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding SkinPreviewLabel}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                            <Border CornerRadius="10" ClipToBounds="True" Padding="6"
                                                    Background="{DynamicResource BgSurface}"
                                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                                <Image Width="110" Height="110" Source="{Binding SkinPreview}"
                                                       Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Panel>
                </ctl:PanelCard>
            </Grid>

            <!-- How it works (DockPanel so the help text wraps instead of overflowing) -->
            <Border Classes="card">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Top"
                            Margin="0,0,12,0"
                            Background="{DynamicResource AccentSubtle}"
                            BorderBrush="{DynamicResource AccentOutline}" BorderThickness="1">
                        <Image Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="{icon:LucideImage Kind=Info, Brush={StaticResource TextSecondary}}"/>
                    </Border>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Help1Text}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding Help2Text}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
